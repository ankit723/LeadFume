generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model SubscriptionType {
  id String @id @default(uuid())
  priceId Json? @default("{}")
  name String @default("")
  description String @default("")
  price Int
  credits Int
  annualDiscount Int @default(10)
  isPopular Boolean @default(false)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subscriptions Subscriptions[]
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
}

model Subscriptions {
  id String @id @default(uuid())
  userId String @unique
  user User @relation("UserSubscriptions", fields: [userId], references: [id])
  subscriptionType SubscriptionType @relation(fields: [subscriptionTypeId], references: [id])
  subscriptionTypeId String
  status SubscriptionStatus @default(ACTIVE)
  price Int
  subscriptionStartDate DateTime
  subscriptionRenewalDate DateTime
}

model User {
  id           String @id @default(uuid())
  customerId String? @unique
  email        String @unique
  firstName    String
  lastName     String
  profileImage String
  phone        String
  dateOfBirth  String
  gender       String
  orders  Request[]
  subscription Subscriptions? @relation("UserSubscriptions")
  creditsAvailable Int @default(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  supportTickets SupportTicket[] 
  ticketReplies TicketReply[]
}

enum EmployeeRole {
  ADMIN
  EMPLOYEE
  SUPPORT
}

model Employee {
  id String @id @default(uuid())
  employeeRole EmployeeRole @default(EMPLOYEE)
  name String
  email String @unique
  password String
  profileImage String
  phone String
  dateOfBirth String
  gender String
  dateOfJoining String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pendingOrders  Request[] @relation("PendingOrders")
  completedOrders  Request[] @relation("CompletedOrders")
  assignedTickets SupportTicket[] @relation("AssignedTickets")
  resolvedTickets SupportTicket[] @relation("ResolvedTickets")
  ticketReplies TicketReply[]
}

enum RequestStatus {
  ORDERED
  PROCESSING
  DELIVERED
  CANCELLED
}

model Request {
  id String @id @default(uuid())
  name String @default("")
  userId String
  user User @relation(fields: [userId], references: [id])
  status RequestStatus @default(ORDERED)
  expectedDeliveryDate DateTime?
  requestQueryParams Json
  requestParameterisedURL String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creditsNeeded Int @default(100)
  assignedEmployeeId String?
  assignedEmployee Employee? @relation(fields: [assignedEmployeeId], references: [id], name: "PendingOrders")
  completedEmployeeId String?
  completedEmployee Employee? @relation(fields: [completedEmployeeId], references: [id], name: "CompletedOrders")
}

model ContactForm {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER_REPLY
  RESOLVED
  CLOSED
}

enum TicketCategory {
  TECHNICAL
  BILLING
  ACCOUNT
  DATA_QUALITY
  FEATURE_REQUEST
  OTHER
}

model SupportTicket {
  id           String        @id @default(uuid())
  ticketNumber String        @unique
  subject      String
  description  String        @db.Text
  category     TicketCategory
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  assignedEmployeeId String?
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id], name: "AssignedTickets")
  resolvedEmployeeId String?
  resolvedEmployee   Employee? @relation(fields: [resolvedEmployeeId], references: [id], name: "ResolvedTickets")
  replies      TicketReply[]
  attachments  TicketAttachment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  resolvedAt   DateTime?
  closedAt     DateTime?
}

model TicketReply {
  id          String        @id @default(uuid())
  message     String        @db.Text
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  employeeId  String?
  employee    Employee?     @relation(fields: [employeeId], references: [id])
  isInternal  Boolean       @default(false)
  attachments TicketAttachment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model TicketAttachment {
  id          String        @id @default(uuid())
  fileName    String
  fileUrl     String
  fileSize    Int
  fileType    String
  ticketId    String?
  ticket      SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  replyId     String?
  reply       TicketReply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
}
 
